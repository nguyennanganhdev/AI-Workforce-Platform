# Copy to services/vinhomes-api/.local-connected/technical-api.env (ignored).
# Launch: powershell -File services/vinhomes-api/scripts/start_technical_tools.ps1 -Connected
# postgresql://; a separate NOSUPERUSER NOBYPASSRLS SELECT/INSERT-only role is required.
# The restored role vinhomes_connected_technical_api has the original grants; set a new DB password.
TECHNICAL_API_DATABASE_URL=
TECHNICAL_API_TENANT_ID=
# Generate 32+ random characters; must equal Coordination COORDINATION_TOOLS_TOKEN.
TECHNICAL_TOOLS_SERVICE_TOKEN=
TECHNICAL_TOOLS_HOST=127.0.0.1
TECHNICAL_TOOLS_PORT=8788
