# Copy to .env.connected (ignored). Use the restored connected tenant, not the demo tenant.
# Restore/setup: docs/teams/chien/DATABASE_BACKUP_AND_ENV_2026-10-04.md
# URL scheme must be postgresql+asyncpg://; use a restricted role, not vinhomes_seed.
VINHOMES_API_HOST=127.0.0.1
VINHOMES_API_PORT=8000
VINHOMES_API_DATABASE_URL=
VINHOMES_API_TENANT_ID=
VINHOMES_API_PASSWORD_AUTH=1
VINHOMES_API_AUTH_URL=
VINHOMES_API_ALLOWED_ORIGINS=http://127.0.0.1:3011,http://localhost:3011,http://127.0.0.1:3020,http://localhost:3020
# Resident contract has a separate origin allowlist; keep it aligned with browser URLs.
VINHOMES_API_RESIDENT_ALLOWED_ORIGINS=http://127.0.0.1:3011,http://localhost:3011,http://127.0.0.1:3020,http://localhost:3020
# Stable image-access signing key: generate 32 random bytes as 64 hex characters.
VINHOMES_API_RESIDENT_SIGNING_KEY=
VINHOMES_API_DEMO_MODE=0
VINHOMES_API_DEV_USER_ID=
# Enable only after configuring a private storage_locations record on loopback.
VINHOMES_API_LOCAL_FILE_STORAGE=0
# Optional file root for local disk storage; the backup includes DB metadata, not these bytes.
# VINHOMES_RESIDENT_FILE_ROOT=/absolute/path/to/private/vinhomes-files
# Reception agent runtime (agent-reception/src/runtime). Leave the URL empty to keep chat without an agent.
# The token (32+ characters) authenticates this API to the runtime. The runtime calls back with a
# per-message delegation signed by RECEPTION_DELEGATION_KEY (hex, 32+ random bytes; backend only).
# API token == agent-reception RECEPTION_SERVICE_TOKEN; delegation key is a different secret.
VINHOMES_API_RECEPTION_SERVICE_TOKEN=
RECEPTION_DELEGATION_KEY=
VINHOMES_API_RECEPTION_URL=
# Supervisor -> API: same value as agent-coordination COORDINATION_SERVICE_TOKEN.
# Must differ from VINHOMES_API_RECEPTION_SERVICE_TOKEN. Generate 32+ random characters.
VINHOMES_API_COORDINATION_SERVICE_TOKEN=
# Report agent: codes of the service categories whose invoices count as repair work, comma separated.
# Empty: the repair bill tool answers REPORT_REPAIR_CATEGORIES_REQUIRED and reports no total.
VINHOMES_API_REPAIR_CATEGORY_CODES=
# Messages one resident may send to the assistant per minute (default 30).
VINHOMES_API_RESIDENT_MESSAGES_PER_MINUTE=30
