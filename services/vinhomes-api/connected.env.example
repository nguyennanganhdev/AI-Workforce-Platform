# Copy to .env.connected (ignored). Never copy the demo tenant or seed configuration.
VINHOMES_API_HOST=127.0.0.1
VINHOMES_API_PORT=8000
VINHOMES_API_DATABASE_URL=
VINHOMES_API_TENANT_ID=
VINHOMES_API_PASSWORD_AUTH=1
VINHOMES_API_AUTH_URL=
VINHOMES_API_ALLOWED_ORIGINS=http://127.0.0.1:3011,http://127.0.0.1:3020
VINHOMES_API_DEMO_MODE=0
VINHOMES_API_DEV_USER_ID=
# Enable only after configuring a private storage_locations record on loopback.
VINHOMES_API_LOCAL_FILE_STORAGE=0
