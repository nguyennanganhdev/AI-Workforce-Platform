# Copy to services/vinhomes-api/.local-connected/knowledge.env (ignored).
# Launch: powershell -File services/vinhomes-api/scripts/start_knowledge.ps1 -Connected
# Use the restored connected DB and tenant. These UUIDs come from tenants / knowledge_bases.
# postgresql:// (Bun), not postgresql+asyncpg://. NOSUPERUSER NOBYPASSRLS role required.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_TENANT_ID=
KNOWLEDGE_BASE_ID=
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-large
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=8787
RECEPTION_API_URL=http://127.0.0.1:8000
# The launcher loads OPENAI_API_KEY / OPENAI_BASE_URL from agent-reception/.env.
# Existing embeddings are 1536 dimensions; retain the active embedding model from the database.
# For Hono server/src/index.ts (instead of standalone serve.ts), also set KNOWLEDGE_ENABLED=1.
# In Compose only, KNOWLEDGE_INTERNAL_HTTP_HOST=api permits the literal internal host http://api:8000.
