{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:team-hoang:report-config:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "template_id",
    "template_version",
    "name",
    "metrics",
    "metric_versions",
    "scope_ids",
    "period",
    "output_format",
    "presentation"
  ],
  "properties": {
    "config_version": { "const": "1.0" },
    "template_id": { "const": "operations-report" },
    "template_version": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["ticket_volume", "sla", "assignments", "outcomes"] }
    },
    "metric_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket_volume", "sla", "assignments", "outcomes"],
      "properties": {
        "ticket_volume": { "const": "1.0.0" },
        "sla": { "const": "1.0.0" },
        "assignments": { "const": "1.0.0" },
        "outcomes": { "const": "1.0.0" }
      }
    },
    "scope_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "timezone"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "output_format": { "const": "docx" },
    "presentation": { "enum": ["summary", "detailed"] }
  }
}
