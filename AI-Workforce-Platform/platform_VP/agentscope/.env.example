# AgentScope local environment template
# Copy this file to .env and replace every CHANGE_ME value before use:
#   Copy-Item .env.example .env
#
# Docker Compose automatically reads .env from the directory containing
# compose.yaml. Python scripts do not automatically load this file unless
# python-dotenv (or an equivalent loader) is configured.

# -----------------------------------------------------------------------------
# Agent service
# -----------------------------------------------------------------------------

# Host port mapped to port 8000 inside the application container.
AGENTSCOPE_PORT=8000

# Used by the Alembic SQL backend when PostgreSQL storage is enabled.
# Inside Docker Compose, use the PostgreSQL service name as the host.
AGENTSCOPE_SQL_URL=postgresql+asyncpg://agentscope:CHANGE_ME@postgres:5432/agentscope
# Shared task state/events/summaries use PostgreSQL by default when the SQL
# URL exists. Set to `primary` only for a Redis-only development deployment.
SHARED_CONTEXT_STORAGE_BACKEND=sql

# Dedicated integration-test database. Never point this variable at a shared
# development or production database; Phase-C/D tests may create and remove
# isolated schemas.
WORKFORCE_TEST_POSTGRES_URL=

# Logging level used by background workers.
LOG_LEVEL=INFO

# Optional path to a custom Python bootstrap module/file for the RAG worker.
AGENTSCOPE_WORKER_BOOTSTRAP=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# The Web UI uses registration/login with Bearer access tokens and a rotating
# HttpOnly refresh-token cookie.
AUTH_ENABLED=true
# Generate two different values, each with at least 32 random bytes. Example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
AUTH_REFRESH_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_PEPPER_AT_LEAST_32_BYTES
AUTH_JWT_ISSUER=agentscope
AUTH_JWT_AUDIENCE=agentscope-api
AUTH_DEFAULT_TENANT_ID=default
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
# false for local HTTP; true behind production HTTPS.
AUTH_COOKIE_SECURE=false
# Explicit origins are required when the browser sends the refresh cookie.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate two additional independent secrets of at least 32 random bytes.
# API keys are stored as keyed hashes; the provisioning secret temporarily
# protects key issuance until an administrator workflow is implemented.
PARTNER_API_KEY_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_PEPPER_AT_LEAST_32_BYTES
PARTNER_API_PROVISIONING_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES

# -----------------------------------------------------------------------------
# PostgreSQL / pgvector
# -----------------------------------------------------------------------------

POSTGRES_DB=agentscope
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# The long-term-memory migration currently uses vector(1536). The embedding
# model supplied to PostgresReMeMemoryStore must return exactly 1536 values.
REME_EMBEDDING_DIMENSIONS=1536

# An OpenAI-compatible embedding endpoint used only after an AREA_MANAGER
# approves a memory candidate. Leave the key empty to keep approval disabled.
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_EMBEDDING_PASS_DIMENSIONS=true

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# The current agent-service example reads the individual settings below.
# Use host "redis" in Docker Compose and "localhost" when running Python on
# the host machine.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Channel and RAG workers use the URL form.
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Team shared-context budgets (server-owned; not editable by Agent Builder)
# -----------------------------------------------------------------------------

# Maximum size injected into one model call for shared ticket context.
SHARED_CONTEXT_PACKET_MAX_TOKENS=12000
# History sub-budget H. Summary triggers at 80% H, keeps about 10% H recent,
# and the generated summary may occupy at most 40% H.
SHARED_CONTEXT_HISTORY_BUDGET_TOKENS=6000
SHARED_CONTEXT_SUMMARY_TRIGGER_RATIO=0.80
SHARED_CONTEXT_RECENT_HISTORY_RATIO=0.10
SHARED_CONTEXT_SUMMARY_MAX_RATIO=0.40
# Initial call plus at most one bounded retry by default.
SHARED_CONTEXT_SUMMARY_ATTEMPTS=2
# Reserved from every model context window for its response.
SHARED_CONTEXT_OUTPUT_RESERVE_RATIO=0.10
SHARED_CONTEXT_PREFLIGHT_MARGIN_TOKENS=256

# Per server-assigned task/worker/customer-requirement cycle. Idle time is free.
COLLABORATION_MAX_EXCHANGES=24
COLLABORATION_MAX_MODEL_CALLS=16
COLLABORATION_MAX_TOKENS=200000
COLLABORATION_MAX_ACTIVE_SECONDS=180
COLLABORATION_MAX_VERIFICATIONS=2

# -----------------------------------------------------------------------------
# MinIO / S3-compatible blob storage
# -----------------------------------------------------------------------------

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENABLED=true
S3_ENDPOINT=http://minio:9000
# URL reachable by partner/customer backends; used only in presigned URLs.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=agentscope
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1

# Optional temporary AWS STS credential. The current agent-service example
# does not pass this value to S3BlobStore yet.
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Optional model providers
# -----------------------------------------------------------------------------

# The Web UI can store provider credentials through its Credentials page.
# These variables are primarily used by standalone examples and Docker-based
# local configuration. Leave providers you do not use empty.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Standalone console example settings.
MODEL_PROVIDER=dashscope
MODEL_NAME=
MODEL_BASE_URL=

# Fixed model used by the Workforce Leader. The Agent Builder model is chosen
# explicitly on the Builder UI. When omitted, the backend uses a conservative
# provider-specific default for Leader sessions.
WORKFORCE_MODEL_NAME=
# Set this to pin one credential when a user stores multiple credentials.
WORKFORCE_MODEL_CREDENTIAL_ID=

# ReMe long-term-memory provider settings.
LLM_BACKEND=openai
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_BASE_URL=

# Optional hosted Mem0 API token. Not required by the local OSS example.
MEM0_API_KEY=

# Realtime example model override.
REALTIME_MODEL=qwen-audio-3.0-realtime-plus

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------

# Enables the AMap/Gaode Maps MCP when set.
AMAP_API_KEY=

# Raises ClawHub API rate limits when set; browsing can work without it.
CLAWHUB_API_TOKEN=

# -----------------------------------------------------------------------------
# Optional demo-only settings
# -----------------------------------------------------------------------------

# Persistent directory for the ReMe demo. Empty means a temporary directory.
REME_WORKSPACE_DIR=

# Set to 1 only when you intentionally want the ReMe demo directory reset.
REME_DEMO_RESET=0

# Node web-UI helper backend port.
PORT=3000
