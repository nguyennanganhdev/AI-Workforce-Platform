FROM python:3.12-slim
WORKDIR /opt/coordination
COPY agent-coordination/pyproject.toml ./
COPY agent-coordination/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY agent-coordination/src ./src
RUN pip install --no-cache-dir --no-deps --no-build-isolation . && useradd --uid 10001 --create-home app
USER app
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 COORDINATION_HOST=0.0.0.0 COORDINATION_PORT=4300
EXPOSE 4300
CMD ["python", "-m", "vinhomes"]
