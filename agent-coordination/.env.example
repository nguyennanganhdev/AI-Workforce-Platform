# Runtime secret references only; never commit real values.
COORDINATION_CONFIG=agent-coordination/config.example.json
COORDINATION_INGRESS_TOKEN=replace-with-service-secret-at-least-32-characters
COORDINATION_MODEL_KEY=replace-via-runtime-secret-provider
# No backend/Authority routes are guessed. Platform supplies the trusted factory.
# Report artifacts: trusted read-only artifact tree, supplied by factory.
COORDINATION_REPORT_ROOT=/artifacts
COORDINATION_REPORT_HASH=replace-with-reviewed-artifact-hash
# Openbot release specifies credential_env; no fixed Coordination default.
# In Openbot's own process: MANAGED_AGENT_TOKEN, OPENAI_API_KEY,
# OPENAI_BASE_URL (optional gateway), BOT_MODEL. Never put their values in chat.
