# ==========================================
# Cấu Hình Môi Trường (Agent Coordination)
# ==========================================

# 1. Môi trường chung
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# 2. Cấu hình Model (LLM)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4
MODEL_API_KEY=sk-your-openai-key-here
# MODEL_API_BASE=https://api.openai.com/v1

# 3. Xác thực (Authentication)
SERVICE_API_KEY=super-secret-backend-key
JWT_SECRET=super-secret-jwt-key

# 4. Trạng thái hoạt động
PORT=8000
ENABLE_HEALTH_CHECK=True
