# Runtime secret references only; never commit real values.
COORDINATION_CONFIG=agent-coordination/config.example.json
COORDINATION_INGRESS_TOKEN=replace-with-service-secret-at-least-32-characters
COORDINATION_MODEL_KEY=replace-via-runtime-secret-provider
# No backend/Authority routes are guessed. Platform supplies the trusted factory.
# Report artifacts: trusted read-only artifact tree, supplied by factory.
COORDINATION_REPORT_ROOT=/artifacts
COORDINATION_REPORT_HASH=replace-with-reviewed-artifact-hash
# Openbot release specifies credential_env; no fixed Coordination default.
# In Openbot's own process: MANAGED_AGENT_TOKEN, OPENAI_API_KEY,
# OPENAI_BASE_URL (optional gateway), BOT_MODEL. Never put their values in chat.

# Supervisor for the Vinhomes business API (src/vinhomes, scripts/start_vinhomes.ps1).
# The token must equal VINHOMES_API_COORDINATION_SERVICE_TOKEN of the business API.
COORDINATION_BACKEND_URL=http://127.0.0.1:8000
COORDINATION_SERVICE_TOKEN=replace-with-service-secret-at-least-32-characters
# Optional: COORDINATION_STATE_PATH, COORDINATION_HOST, COORDINATION_PORT (4300), COORDINATION_POLL_SECONDS (2).
# Specialists (set both or neither). The planner model, and the OpenBot (agent-bot) specialists run on.
# OPENAI_API_KEY is read from agent-reception/.env by the start scripts. MANAGED_AGENT_TOKEN is the
# shared secret between this runtime and the Bot; generate your own.
# COORDINATION_MODEL=gpt-5.4-mini
# COORDINATION_OPENBOT_URL=http://127.0.0.1:4200/ag-ui
# MANAGED_AGENT_TOKEN=replace-with-a-generated-secret
# Optional: COORDINATION_OPENBOT_MODEL (default: COORDINATION_MODEL), COORDINATION_MODEL_BASE_URL,
# COORDINATION_TOKEN_LIMIT (400000 per session).
