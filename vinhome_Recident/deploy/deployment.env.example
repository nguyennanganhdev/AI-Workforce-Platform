# Copy to deployment.env (ignored by git) and fill in. URL-encode credentials inside connection URLs.
# Run:  docker compose --env-file deployment.env up -d --build

# --- Business API ---------------------------------------------------------------------------------
# An already migrated PostgreSQL database, reached with a restricted runtime role.
VINHOMES_API_DATABASE_URL=
VINHOMES_TENANT_ID=
# 32 bytes as hex (openssl rand -hex 32) / random strings. Never reuse a value between two of them.
RESIDENT_SIGNING_KEY=
RECEPTION_DELEGATION_KEY=
RECEPTION_SERVICE_TOKEN=
COORDINATION_SERVICE_TOKEN=
TECHNICAL_TOOLS_SERVICE_TOKEN=
ROUTINES_SERVICE_TOKEN=
FACTORY_SERVICE_TOKEN=
# Base64 of 32 bytes. Seals model keys typed in the app; keep it with the backups.
MODEL_CREDENTIALS_KEY=

# Photos and files: any S3 service. The API holds its own key for the bucket named here.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=vinhomes-files
# Origin a browser can reach for direct uploads; https when the apps are served over https.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# --- Platform services the API calls (not part of this package) ------------------------------------
# The platform's own API, read by the live ticket list in the staff app (not the business API).
# PLATFORM_API_URL=http://platform:3001
# COORDINATION_URL=http://coordination:4300
# TECHNICAL_TOOLS_URL=http://technical-tools:8788/internal/technical/v1
# KNOWLEDGE_URL=http://knowledge:8787
# ROUTINES_URL=http://routines:8789/internal/routines/v1
# FACTORY_URL=http://factory:4010

# --- Models ---------------------------------------------------------------------------------------
OPENAI_API_KEY=
RECEPTION_AGENT=loop
RECEPTION_MODEL=gpt-5.4-mini
COORDINATION_MODEL=gpt-5.4-mini
# Another vendor for a role: provider name, its own key, and an address only for `custom`.
RECEPTION_MODEL_PROVIDER=
RECEPTION_MODEL_API_KEY=
RECEPTION_MODEL_BASE_URL=
# 0 when the specialists' model reads no images.
SPECIALIST_SEES_IMAGES=1
# 1: the Supervisor approves its own plan; 0: management approves each plan.
SUPERVISOR_APPROVES_PLANS=1
# Codes of the service categories whose bills count as repairs (report agent), comma separated.
REPAIR_CATEGORY_CODES=

# --- Exposure -------------------------------------------------------------------------------------
VINHOMES_BIND_ADDRESS=127.0.0.1
RESIDENT_PORT=3011
OPERATIONS_PORT=3020
FIELD_PORT=3023
VINHOMES_API_PORT=8000
# Browser origins allowed to sign in and write; add the https addresses when serving over https.
VINHOMES_ALLOWED_ORIGINS=http://localhost:3020,http://localhost:3011,http://localhost:3023
# 1 once the apps are only reached over https: the session cookie is then never sent in clear.
SECURE_COOKIES=0
