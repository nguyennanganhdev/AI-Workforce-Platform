# Do not copy this file by hand: deploy/new-env.ps1 (Windows) or deploy/new-env.sh writes deploy/deployment.env
# (ignored by git) from it with fresh random secrets. You then paste OPENAI_API_KEY and start the stack:
#   docker compose --env-file deploy/deployment.env -f deploy/compose.yml up -d --build

# --- The one value you fill in ---------------------------------------------------------------------
# Model key of the Reception agent; also used to search the knowledge pack by meaning.
OPENAI_API_KEY=

# Password recovery is disabled until SMTP host/from and a public HTTPS origin are configured.
VINHOMES_PUBLIC_URL=https://vinhome-platform.duckdns.org
VINHOMES_SMTP_HOST=
VINHOMES_SMTP_PORT=587
VINHOMES_SMTP_SECURITY=starttls
VINHOMES_SMTP_FROM=
VINHOMES_SMTP_USERNAME=
VINHOMES_SMTP_PASSWORD=

# --- Secrets, generated (never reuse a value between two of them) -----------------------------------
# PostgreSQL: the owner (creates the schema, loads data) and the plain role the API runs as.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
# Default database; change only after preparing/verifying a separate clean database or restore.
VINHOMES_DATABASE_NAME=vinhomes
# MinIO: its administrator, and the API's own key, which may use the one bucket and nothing else.
MINIO_ROOT_USER=vinhomes-root
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=vinhomes-api
S3_SECRET_KEY=
S3_BUCKET=vinhomes-files
RESIDENT_SIGNING_KEY=
RECEPTION_DELEGATION_KEY=
RECEPTION_SERVICE_TOKEN=

# --- Sample world -----------------------------------------------------------------------------------
# 1: builds the sample world (360 homes, 900 past requests) and gives its first accounts this password.
# 0: only the base organisation; load real data with `import` and create the first administrator (README).
VINHOMES_SAMPLE_WORLD=0
# Explicit isolated travel simulation; requires travel_seed --enable-mock. Never connects a real provider.
VINHOMES_TRAVEL_MOCK_ENABLED=0
# Explicitly load a reviewed/scoped knowledge pack; normal restarts preserve owner-managed metadata.
VINHOMES_LOAD_KNOWLEDGE=0
# A new path starts fresh conversation memory after a data reset; keep the old file only for rollback.
RECEPTION_STATE_PATH=/var/lib/reception/reception.sqlite3
# First password of the sample accounts, 12 to 128 characters. Used once per account: changing it later
# does not change a password that already exists.
DEMO_PASSWORD=

# --- Reception agent --------------------------------------------------------------------------------
RECEPTION_AGENT=loop
RECEPTION_MODEL=gpt-6-luna
# OpenAI uses the Responses API (reasoning with tools); `chat` for Chat Completions vendors.
RECEPTION_MODEL_API=
# Reasoning per conversation turn, and for the step that turns a report into a request.
RECEPTION_REASONING_EFFORT=low
RECEPTION_ASSESSMENT_REASONING_EFFORT=medium
# Another vendor for this role: provider name, its own key, and an address only for `custom`.
RECEPTION_MODEL_PROVIDER=
RECEPTION_MODEL_API_KEY=
RECEPTION_MODEL_BASE_URL=
# Another OpenAI key for the knowledge search only (default: OPENAI_API_KEY).
# OpenAI embeddings have an independent key setting (text-embedding-3-large,1536 dimensions).
# Does not inherit RECEPTION_MODEL_API_KEY. Empty EMBEDDING_API_KEY disables semantic search; lexical fallback remains.
# EMBEDDING_API_KEY=
# Codes of the service categories whose bills count as repairs (management reports), comma separated.
REPAIR_CATEGORY_CODES=

# --- AI platform (Workforce v1) -----------------------------------------------------------------------
# Empty URL: the outbound bridge is off. MCP discovery can still run with its own token. The platform's operator runs
# deploy/platform/apply.py and hands over platform.env: paste its lines here (deploy/platform/README.md).
# The URL is the platform as the containers reach it, e.g. http://host.docker.internal:8800.
VINHOMES_API_PLATFORM_URL=
VINHOMES_API_PLATFORM_CUSTOMER_KEY=
VINHOMES_API_PLATFORM_PROVIDER_KEY=
VINHOMES_API_PLATFORM_SIGNING_KEY_ID=
VINHOMES_API_PLATFORM_SIGNING_SECRET=
# Generated. Enables /mcp independently of PLATFORM_URL; platform sends Authorization: Bearer <token>.
# Empty token disables /mcp. Use HTTPS or a private SSH/VPN connection when transferring this credential.
VINHOMES_API_PLATFORM_MCP_TOKEN=
# Encrypts credentials saved from Domain Admin. Keep stable and include in private configuration backups.
# Generated once by new-env; existing installations add a fresh 64-character random hex value once.
VINHOMES_API_CONFIG_ENCRYPTION_KEY=
# Explicit internal Platform hosts; public Platform addresses require HTTPS and public DNS resolution.
VINHOMES_PLATFORM_ALLOWED_HOSTS=awp-platform,host.docker.internal

# --- Exposure ---------------------------------------------------------------------------------------
VINHOMES_BIND_ADDRESS=127.0.0.1
# The one address of the apps (login, resident app, staff app and API behind it).
GATEWAY_PORT=8080
# Empty to run several copies of the API (--scale api=2): each then gets a free port.
VINHOMES_API_PORT=8000
# PostgreSQL for a database tool on this machine (loopback only): user vinhomes_owner, database vinhomes.
POSTGRES_PORT=5560
# Browser origins allowed to sign in and write: the address of the gateway. Change it together with
# GATEWAY_PORT, and use https when serving over https.
VINHOMES_ALLOWED_ORIGINS=http://localhost:8080
# 1 once the apps are only reached over https: the session cookie is then never sent in clear.
SECURE_COOKIES=0

# --- On a server (Nginx TLS overlays; deploy/HTTPS.md) ----------------------------------------------
# The name people and the AI platform use; it must point at this server. Then also set
# VINHOMES_ALLOWED_ORIGINS=https://<that name> and SECURE_COOKIES=1.
# VINHOMES_DOMAIN=
# One Nginx gateway directly reaches the API, for both HTTP and HTTPS.
# TRUSTED_PROXY_HOPS=1
# HTTPS_PORT=443
# ACME_WEBROOT=/srv/vinhomes-acme
# TLS_CERT_DIR=/srv/vinhomes-tls
# With TLS and public GATEWAY_PORT=80, preserve an SSH-only HTTP MCP listener on host port 8080:
# GATEWAY_PRIVATE_PORT=8080

# --- Backups, images, scheduled sync (all optional; README) ------------------------------------------
# A backup every day at this hour (Vietnam time); how many dumps are kept; a host folder instead of the volume.
# BACKUP_HOUR=2
# BACKUP_KEEP=7
# BACKUP_DIR=
# Images from a registry instead of a build on this machine: ghcr.io/<org>/vinhomes and a release tag.
# VINHOMES_IMAGE_PREFIX=
# VINHOMES_IMAGE_TAG=
# Optional: API, init, scheduler and platform-sync use this tag together, so migrations match the API.
# VINHOMES_API_IMAGE_TAG=
# Optional independent Reception release; falls back to VINHOMES_IMAGE_TAG.
# VINHOMES_RECEPTION_IMAGE_TAG=
# Additional trusted MCP Host headers, comma separated. Domain/IP hosts in VINHOMES_ALLOWED_ORIGINS
# and loopback are already allowed. Required only for a separate internal DNS name.
# MCP_ALLOWED_HOSTS=api:8000
# VINHOMES_OPERATIONS_IMAGE_TAG=
# Optional: release only the resident frontend/landing without changing API or operations images.
# VINHOMES_RESIDENT_IMAGE_TAG=
# With --profile sync: the folder of export files and the seconds between two looks at it.
# DATA_SYNC_DIR=./sync
# DATA_SYNC_SECONDS=300

# --- A database or an S3 service of your own (leave commented to use the ones compose starts) --------
# The owner URL is plain postgresql://, the API URL postgresql+asyncpg:// with role vinhomes_api and
# API_DB_PASSWORD; URL-encode credentials.
# MIGRATION_DATABASE_URL=
# VINHOMES_API_DATABASE_URL=
# With your own S3: S3_ACCESS_KEY / S3_SECRET_KEY must already exist there, and MINIO_ROOT_USER is set empty.
# S3_ENDPOINT=
# S3_REGION=us-east-1
# An https origin browsers can reach, to send photos straight to the bucket instead of through the API.
# S3_PUBLIC_ENDPOINT=

# Linked Vin customers and legacy chatbot intake are independent rollouts.
# Keep both false until migration/client provisioning and acceptance complete.
VINHOMES_CUSTOMER_PLATFORM_ENABLED=false
VINHOMES_CHATBOT_COHORT_CUTOVER_ENABLED=false
VINHOMES_CHATBOT_PLATFORM_COHORTS=[]
