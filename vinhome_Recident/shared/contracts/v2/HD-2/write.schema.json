{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "fact",
        "finding",
        "assumption",
        "objection",
        "agreement",
        "question",
        "plan_step",
        "assignment",
        "result"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "agent",
            "human",
            "system",
            "tool"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id",
        "name"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "tool_result",
              "passage",
              "message",
              "file",
              "entry",
              "finding"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id"
        ]
      }
    },
    "target_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "data_origin": {
      "enum": [
        "real",
        "public",
        "team_written",
        "synthetic",
        "test_run"
      ]
    }
  },
  "required": [
    "request_id",
    "kind",
    "statement",
    "author",
    "sources",
    "data_origin"
  ],
  "title": "HD-2 yêu cầu ghi một mục"
}
