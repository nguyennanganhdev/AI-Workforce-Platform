{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "model_calls": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "enum": [
        "USD",
        "VND"
      ]
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "findings_total": {
      "type": "integer",
      "minimum": 0
    },
    "findings_sourced": {
      "type": "integer",
      "minimum": 0
    },
    "entries_demoted": {
      "type": "integer",
      "minimum": 0
    },
    "plan_steps_blocked": {
      "type": "integer",
      "minimum": 0
    },
    "human_edits": {
      "type": "integer",
      "minimum": 0
    },
    "uses_sample_data": {
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "model_calls",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "cost",
    "currency",
    "duration_seconds",
    "findings_total",
    "findings_sourced",
    "entries_demoted",
    "plan_steps_blocked",
    "human_edits",
    "uses_sample_data"
  ],
  "title": "HD-5 số liệu của một vụ"
}
