{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "usage_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_version_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "reception",
        "supervisor",
        "specialist",
        "judge",
        "summarizer",
        "other"
      ]
    },
    "phase": {
      "enum": [
        "intake",
        "independent",
        "review",
        "merge",
        "execution",
        "evaluation"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "timeout"
      ]
    }
  },
  "required": [
    "usage_id",
    "case_id",
    "run_id",
    "role",
    "provider",
    "model",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "started_at",
    "duration_ms",
    "status"
  ],
  "title": "HD-5 một bản ghi sổ chi phí"
}
