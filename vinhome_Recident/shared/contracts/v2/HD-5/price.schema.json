{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "enum": [
        "USD",
        "VND"
      ]
    },
    "input_per_million": {
      "type": "number",
      "minimum": 0
    },
    "cached_input_per_million": {
      "type": "number",
      "minimum": 0
    },
    "output_per_million": {
      "type": "number",
      "minimum": 0
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "checked_on": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "provider",
    "model",
    "currency",
    "input_per_million",
    "cached_input_per_million",
    "output_per_million",
    "effective_from",
    "source_url",
    "checked_on"
  ],
  "title": "HD-5 một dòng bảng giá model"
}
