{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "core_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pack_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "banned_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_until_after_demo": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "reason"
        ]
      }
    }
  },
  "required": [
    "core_paths",
    "pack_paths",
    "banned_terms",
    "allowed_until_after_demo",
    "known_violations"
  ],
  "title": "HD-6 cấu hình kiểm tra ranh giới"
}
