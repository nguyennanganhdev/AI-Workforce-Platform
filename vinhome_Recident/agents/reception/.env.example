PORT=4202
HOST=0.0.0.0
RECEPTION_MODEL_PROVIDER=openai
# Empty selects the provider default; set explicitly for your deployment.
# Checked with gpt-5.4-mini; gpt-4o-mini misreads follow-up messages (see the handoff note).
RECEPTION_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Python runtime (src/runtime): one Reception turn per resident message.
# PORT/HOST above belong to the TypeScript entrypoint. start_runtime.ps1 binds Python to 127.0.0.1:4202.
RECEPTION_AGENT=loop
# Same value as VINHOMES_API_RECEPTION_SERVICE_TOKEN on the backend; 32+ characters.
# It only authenticates the backend calling POST /v1/turns; each turn carries its own delegation.
RECEPTION_SERVICE_TOKEN=
RECEPTION_BACKEND_URL=http://127.0.0.1:8000
RECEPTION_STATE_PATH=.reception-state/reception.sqlite3
# Base URL of knowledge search for RAG (standalone default port 8787). Empty disables this integration.
RECEPTION_KNOWLEDGE_URL=
# OpenAI-compatible chat completions; the runtime needs RECEPTION_MODEL and OPENAI_API_KEY.
OPENAI_BASE_URL=
# The Python runtime (src/runtime) with another vendor: RECEPTION_MODEL_PROVIDER above may be
# openai, google, deepseek, groq, anthropic or custom, with that vendor's own key and, for custom,
# its address. OPENAI_API_KEY / OPENAI_BASE_URL are then left for the embeddings.
RECEPTION_MODEL_API_KEY=
RECEPTION_MODEL_BASE_URL=
# Embeddings of the knowledge service, when they must not use OPENAI_API_KEY / OPENAI_BASE_URL.
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_BASE_URL=
