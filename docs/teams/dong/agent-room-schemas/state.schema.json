        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
