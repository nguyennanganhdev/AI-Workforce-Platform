          "type": "string"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "agent_version_id",
        "role"
      ],
      "title": "ParticipantSpec",
      "type": "object"
    },
    "PutContext": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "put_context",
          "default": "put_context",
          "title": "Operation",
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/ContextItem"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "item"
      ],
      "title": "PutContext",
      "type": "object"
    },
