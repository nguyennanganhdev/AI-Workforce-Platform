{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActiveOperation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "dedup_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dedup Key",
          "type": "string"
        },
        "fence": {
          "title": "Fence",
          "type": "integer"
        },
        "command": {
          "$ref": "#/$defs/Command"
        },
        "participant": {
          "$ref": "#/$defs/Participant"
        },
        "source_run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Run Id",
          "type": "string"
        },
        "artifact_hash": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Hash"
        },
        "mailbox_message_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Mailbox Message Ids",
          "type": "array"
        },
        "dispatch_started": {
          "default": true,
          "title": "Dispatch Started",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "dedup_key",
        "fence",
        "command",
        "participant",
        "source_run_id"
      ],
      "title": "ActiveOperation",
      "type": "object"
    },
    "AddParticipant": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "add_participant",
          "default": "add_participant",
          "title": "Operation",
          "type": "string"
        },
        "participant": {
          "$ref": "#/$defs/ParticipantSpec"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "participant"
      ],
      "title": "AddParticipant",
      "type": "object"
    },
    "AppendMessage": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "append_message",
          "default": "append_message",
          "title": "Operation",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/MessageInput"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "message"
      ],
      "title": "AppendMessage",
      "type": "object"
    },
    "CancelTurn": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "cancel_turn",
          "default": "cancel_turn",
          "title": "Operation",
          "type": "string"
        },
        "target_operation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Operation Id",
          "type": "string"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "target_operation_id"
      ],
      "title": "CancelTurn",
      "type": "object"
    },
    "CloseRoom": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "close_room",
          "default": "close_room",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "room_id",
        "expected_room_version"
      ],
      "title": "CloseRoom",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1",
          "default": "1",
          "title": "Contract Version",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "trace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "add_participant": "#/$defs/AddParticipant",
              "append_message": "#/$defs/AppendMessage",
              "cancel_turn": "#/$defs/CancelTurn",
              "close_room": "#/$defs/CloseRoom",
              "mention_agent": "#/$defs/MentionAgent",
              "open_room": "#/$defs/OpenRoom",
              "put_context": "#/$defs/PutContext",
              "put_task": "#/$defs/PutTask",
              "run_turn": "#/$defs/RunTurn",
              "update_turn_policy": "#/$defs/UpdateTurnPolicy"
            },
            "propertyName": "operation"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OpenRoom"
            },
            {
              "$ref": "#/$defs/AppendMessage"
            },
            {
              "$ref": "#/$defs/RunTurn"
            },
            {
              "$ref": "#/$defs/MentionAgent"
            },
            {
              "$ref": "#/$defs/PutTask"
            },
            {
              "$ref": "#/$defs/PutContext"
            },
            {
              "$ref": "#/$defs/AddParticipant"
            },
            {
              "$ref": "#/$defs/UpdateTurnPolicy"
            },
            {
              "$ref": "#/$defs/CloseRoom"
            },
            {
              "$ref": "#/$defs/CancelTurn"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "idempotency_key",
        "context",
        "payload"
      ],
      "title": "Command",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "principal_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "initiated_by_user_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initiated By User Id"
        },
        "domain_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "ticket_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Ticket Id",
          "type": "string"
        },
        "ticket_generation": {
          "minimum": 0,
          "title": "Ticket Generation",
          "type": "integer"
        },
        "binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "principal_id",
        "domain_id",
        "workspace_id",
        "ticket_id",
        "ticket_generation",
        "binding_id",
        "run_id"
      ],
      "title": "Context",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "reader_agent_version_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reader Agent Version Ids",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "content",
        "reader_agent_version_ids"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "const": "error",
          "default": "error",
          "title": "Status",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "request_id",
        "error"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FollowUp": {
      "additionalProperties": false,
      "properties": {
        "recipient_agent_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Recipient Agent Version Id",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "recipient_agent_version_id",
        "content"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "MailItem": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        },
        "pending_agent_version_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Pending Agent Version Ids",
          "type": "array"
        }
      },
      "required": [
        "message",
        "pending_agent_version_ids"
      ],
      "title": "MailItem",
      "type": "object"
    },
    "MentionAgent": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "mention_agent",
          "default": "mention_agent",
          "title": "Operation",
          "type": "string"
        },
        "mentioned_agent_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mentioned Agent Id",
          "type": "string"
        },
        "instruction": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "in_reply_to_message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Reply To Message Id"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "mentioned_agent_id",
        "instruction"
      ],
      "title": "MentionAgent",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "delivery": {
          "default": "broadcast",
          "enum": [
            "broadcast",
            "direct"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "recipient_agent_version_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient Agent Version Id"
        },
        "in_reply_to_message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Reply To Message Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "message_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "sender": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Sender",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "content",
        "message_id",
        "sequence",
        "sender",
        "timestamp"
      ],
      "title": "Message",
      "type": "object"
    },
    "MessageInput": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "delivery": {
          "default": "broadcast",
          "enum": [
            "broadcast",
            "direct"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "recipient_agent_version_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient Agent Version Id"
        },
        "in_reply_to_message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Reply To Message Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "content"
      ],
      "title": "MessageInput",
      "type": "object"
    },
    "OpenRoom": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "operation": {
          "const": "open_room",
          "default": "open_room",
          "title": "Operation",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "groupchat_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Groupchat Version Id",
          "type": "string"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/ParticipantSpec"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "turn_policy": {
          "$ref": "#/$defs/TurnPolicy"
        },
        "initial_message": {
          "$ref": "#/$defs/MessageInput"
        },
        "ticket_context": {
          "items": {
            "$ref": "#/$defs/ContextItem"
          },
          "title": "Ticket Context",
          "type": "array"
        }
      },
      "required": [
        "groupchat_version_id",
        "participants",
        "initial_message"
      ],
      "title": "OpenRoom",
      "type": "object"
    },
    "OperationRecord": {
      "additionalProperties": false,
      "properties": {
        "semantic_hash": {
          "title": "Semantic Hash",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/Success"
            },
            {
              "$ref": "#/$defs/Failure"
            }
          ],
          "title": "Result"
        }
      },
      "required": [
        "semantic_hash",
        "result"
      ],
      "title": "OperationRecord",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
