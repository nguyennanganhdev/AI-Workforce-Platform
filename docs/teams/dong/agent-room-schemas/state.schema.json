        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "platform_agent_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Platform Agent Id",
          "type": "string"
        },
        "member_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Member Id",
          "type": "string"
        },
        "binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "binding_generation": {
          "minimum": 1,
          "title": "Binding Generation",
          "type": "integer"
