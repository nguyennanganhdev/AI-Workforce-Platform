      "title": "CloseRoom",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "principal_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "domain_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "ticket_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Ticket Id",
          "type": "string"
        },
        "ticket_generation": {
          "minimum": 0,
          "title": "Ticket Generation",
          "type": "integer"
        },
        "binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "principal_id",
        "domain_id",
        "workspace_id",
        "ticket_id",
        "ticket_generation",
        "binding_id",
        "run_id"
      ],
      "title": "Context",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "reader_agent_version_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reader Agent Version Ids",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "content",
        "reader_agent_version_ids"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "MentionAgent": {
      "additionalProperties": false,
