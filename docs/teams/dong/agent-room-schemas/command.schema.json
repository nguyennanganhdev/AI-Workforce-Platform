    "TaskItem": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "description": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "assignee_agent_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assignee Agent Version Id",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "result_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Result Refs",
          "type": "array"
        },
        "reader_agent_version_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
