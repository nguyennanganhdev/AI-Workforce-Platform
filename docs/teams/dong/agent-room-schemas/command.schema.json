    "TurnPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "default": 12,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_consecutive_turns": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Max Consecutive Turns",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "TurnPolicy",
      "type": "object"
    },
    "UpdateTurnPolicy": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "room_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "update_turn_policy",
          "default": "update_turn_policy",
          "title": "Operation",
          "type": "string"
