            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "in_reply_to_message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Reply To Message Id"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "mentioned_agent_id",
        "instruction"
      ],
      "title": "MentionAgent",
      "type": "object"
    },
    "MessageInput": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "delivery": {
          "default": "broadcast",
          "enum": [
            "broadcast",
            "direct"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "recipient_agent_version_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient Agent Version Id"
        },
        "in_reply_to_message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
