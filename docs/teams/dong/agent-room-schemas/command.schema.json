          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "expected_room_version": {
          "minimum": 1,
          "title": "Expected Room Version",
          "type": "integer"
        },
        "operation": {
          "const": "add_participant",
          "default": "add_participant",
          "title": "Operation",
          "type": "string"
        },
        "participant": {
          "$ref": "#/$defs/ParticipantSpec"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "participant"
      ],
      "title": "AddParticipant",
      "type": "object"
    },
