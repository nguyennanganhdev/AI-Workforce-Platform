            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Reply To Message Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "content"
      ],
      "title": "MessageInput",
      "type": "object"
    },
    "OpenRoom": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "operation": {
          "const": "open_room",
          "default": "open_room",
          "title": "Operation",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "groupchat_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Groupchat Version Id",
          "type": "string"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/ParticipantSpec"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "turn_policy": {
          "$ref": "#/$defs/TurnPolicy"
        },
        "initial_message": {
          "$ref": "#/$defs/MessageInput"
        },
        "ticket_context": {
          "items": {
            "$ref": "#/$defs/ContextItem"
          },
          "title": "Ticket Context",
          "type": "array"
        }
      },
      "required": [
        "groupchat_version_id",
        "participants",
        "initial_message"
      ],
      "title": "OpenRoom",
      "type": "object"
    },
    "ParticipantSpec": {
      "additionalProperties": false,
