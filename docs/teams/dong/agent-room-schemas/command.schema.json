        "turn_policy": {
          "$ref": "#/$defs/TurnPolicy"
        }
      },
      "required": [
        "room_id",
        "expected_room_version",
        "turn_policy"
      ],
      "title": "UpdateTurnPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1",
      "default": "1",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "add_participant": "#/$defs/AddParticipant",
          "append_message": "#/$defs/AppendMessage",
          "cancel_turn": "#/$defs/CancelTurn",
          "close_room": "#/$defs/CloseRoom",
          "mention_agent": "#/$defs/MentionAgent",
          "open_room": "#/$defs/OpenRoom",
          "put_context": "#/$defs/PutContext",
          "put_task": "#/$defs/PutTask",
          "run_turn": "#/$defs/RunTurn",
          "update_turn_policy": "#/$defs/UpdateTurnPolicy"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OpenRoom"
        },
        {
          "$ref": "#/$defs/AppendMessage"
        },
        {
          "$ref": "#/$defs/RunTurn"
        },
        {
          "$ref": "#/$defs/MentionAgent"
        },
        {
          "$ref": "#/$defs/PutTask"
        },
        {
          "$ref": "#/$defs/PutContext"
        },
        {
          "$ref": "#/$defs/AddParticipant"
        },
        {
          "$ref": "#/$defs/UpdateTurnPolicy"
        },
        {
          "$ref": "#/$defs/CloseRoom"
        },
        {
          "$ref": "#/$defs/CancelTurn"
        }
      ],
      "title": "Payload"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "idempotency_key",
    "context",
    "payload"
  ],
  "title": "Command",
  "type": "object"
}
