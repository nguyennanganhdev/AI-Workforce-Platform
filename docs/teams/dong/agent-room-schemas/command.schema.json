        "speaker_agent_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Speaker Agent Version Id",
          "type": "string"
        },
        "instruction": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
