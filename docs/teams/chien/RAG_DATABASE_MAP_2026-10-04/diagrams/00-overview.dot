digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad="0.5", nodesep="0.65", ranksep="0.85", splines=polyline, outputorder=edgesfirst, fontname="Segoe UI", fontsize=23, labelloc=t, label="RAG VINHOMES · CÁC BÊN DÙNG CHUNG MỘT KHO TRI THỨC"];
node [shape=plain, fontname="Segoe UI", fontsize=16];
edge [fontname="Segoe UI", fontsize=12, color="#53657b", penwidth=1.4, arrowsize=0.7];
"source" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="198" BGCOLOR="#e8edf2" ALIGN="LEFT"><B>Nhóm dữ liệu / BQL</B></TD></TR><TR><TD WIDTH="198" ALIGN="LEFT">Data-Vinhome</TD></TR><TR><TD WIDTH="198" ALIGN="LEFT"><FONT POINT-SIZE="13">169 files · 140 Markdown</FONT></TD></TR><TR><TD WIDTH="198" ALIGN="LEFT"><FONT POINT-SIZE="13">115 tài liệu được published</FONT></TD></TR></TABLE>>];
"ingest" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="267" BGCOLOR="#e4eeff" ALIGN="LEFT"><B>Quang + Chiến · Nạp</B></TD></TR><TR><TD WIDTH="267" ALIGN="LEFT">publish.ts / ingest.ts</TD></TR><TR><TD WIDTH="267" ALIGN="LEFT"><FONT POINT-SIZE="13">Metadata + scope → version → chunks</FONT></TD></TR><TR><TD WIDTH="267" ALIGN="LEFT"><FONT POINT-SIZE="13">Model 1536 chiều · cosine</FONT></TD></TR></TABLE>>];
"db" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="262" BGCOLOR="#e0f5eb" ALIGN="LEFT"><B>PostgreSQL dùng chung</B></TD></TR><TR><TD WIDTH="262" ALIGN="LEFT">14 RAG + 5 memory; 38 bảng nền</TD></TR><TR><TD WIDTH="262" ALIGN="LEFT"><FONT POINT-SIZE="13">279 chunks · 279 embeddings</FONT></TD></TR><TR><TD WIDTH="262" ALIGN="LEFT"><FONT POINT-SIZE="13">Quyền / file / runtime / memory</FONT></TD></TR></TABLE>>];
"search" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="223" BGCOLOR="#fff1d8" ALIGN="LEFT"><B>Quang · Hybrid retrieval</B></TD></TR><TR><TD WIDTH="223" ALIGN="LEFT">vector + keyword + RRF</TD></TR><TR><TD WIDTH="223" ALIGN="LEFT"><FONT POINT-SIZE="13">topK=5 · minSimilarity=0.35</FONT></TD></TR></TABLE>>];
"auth" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="254" BGCOLOR="#e0f5eb" ALIGN="LEFT"><B>Chiến · Authority</B></TD></TR><TR><TD WIDTH="254" ALIGN="LEFT">delegation + residence + grant</TD></TR><TR><TD WIDTH="254" ALIGN="LEFT"><FONT POINT-SIZE="13">Không tin quyền do agent tự khai</FONT></TD></TR></TABLE>>];
"reception" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="245" BGCOLOR="#e4eeff" ALIGN="LEFT"><B>Hoàng · Reception</B></TD></TR><TR><TD WIDTH="245" ALIGN="LEFT">Gọi RAG và viết câu có nguồn</TD></TR><TR><TD WIDTH="245" ALIGN="LEFT"><FONT POINT-SIZE="13">Passages → answer + citations</FONT></TD></TR></TABLE>>];
"runtime" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="241" BGCOLOR="#f0e5ff" ALIGN="LEFT"><B>Đông / platform · Runtime</B></TD></TR><TR><TD WIDTH="241" ALIGN="LEFT">run · binding · namespace</TD></TR><TR><TD WIDTH="241" ALIGN="LEFT"><FONT POINT-SIZE="13">Audience và memory access</FONT></TD></TR></TABLE>>];
"ops" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="221" BGCOLOR="#e8edf2" ALIGN="LEFT"><B>Chiến · Operations</B></TD></TR><TR><TD WIDTH="221" ALIGN="LEFT">Keyword search</TD></TR><TR><TD WIDTH="221" ALIGN="LEFT"><FONT POINT-SIZE="13">Chính sách allow ACL khác RAG</FONT></TD></TR></TABLE>>];
"source" -> "ingest" [label="nạp tài liệu",style="dashed",color="#3268a8"];
"ingest" -> "db" [label="ghi docs/chunks/vectors",style="dashed",color="#3268a8"];
"db" -> "search" [label="đọc dữ liệu đã lọc",style="dashed",color="#3268a8"];
"auth" -> "search" [label="AuthorizedContext",style="dashed",color="#3268a8"];
"search" -> "reception" [label="passages + IDs",style="dashed",color="#3268a8"];
"runtime" -> "auth" [label="run / binding / principal",style="dashed",color="#3268a8"];
"db" -> "ops" [label="keyword + allow ACL",style="dashed",color="#3268a8"];
"legend" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="538" BGCOLOR="#f3f5f8" ALIGN="LEFT"><B>CÁCH ĐỌC</B></TD></TR><TR><TD WIDTH="538" ALIGN="LEFT">Số liệu snapshot 03/10; phân team theo code/handoff kiểm ngày 04/10.</TD></TR><TR><TD WIDTH="538" ALIGN="LEFT"><FONT POINT-SIZE="13">Snapshot 03/10/2026 · code kiểm ngày 04/10</FONT></TD></TR><TR><TD WIDTH="538" ALIGN="LEFT"><FONT POINT-SIZE="13">FK vẽ CHA → CON (con giữ khóa ngoại)</FONT></TD></TR><TR><TD WIDTH="538" ALIGN="LEFT"><FONT POINT-SIZE="13">Nét đứt: bước ứng dụng / API, không phải FK</FONT></TD></TR></TABLE>>];
}