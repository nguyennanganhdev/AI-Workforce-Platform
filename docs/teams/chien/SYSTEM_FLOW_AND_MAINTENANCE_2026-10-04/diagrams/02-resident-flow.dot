digraph Resident {
  graph [rankdir=TB, bgcolor="#f8fafc", pad="0.35", nodesep="0.5", ranksep="0.55", fontname="Segoe UI", fontsize=24, label="LUỒNG ĐÍCH — TỪ CƯ DÂN ĐẾN ĐÓNG TICKET\nBackend kiểm quyền và lưu quyết định ở từng bước", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=16, color="#cbd5e1", fillcolor="white", margin="0.35,0.20"];
  edge [fontname="Segoe UI", fontsize=12, color="#64748b", arrowsize=0.7];
  msg [label="Cư dân đăng nhập → gửi tin / ảnh"];
  be [label="Backend xác minh + commit\nMessage / file / binding / delegation", fillcolor="#dbeafe"];
  r [label="Reception hỏi rõ + đánh giá đề xuất\nBackend policy quyết định", fillcolor="#ffedd5"];
  qa [label="Hỏi đáp → RAG có nguồn\nThiếu nguồn → inquiry BQL", fillcolor="#ede9fe"];
  help [label="Self-help đủ điều kiện đã duyệt\nKhông phù hợp / từ chối → onsite", fillcolor="#ede9fe"];
  emergency [label="Khẩn cấp → người có trách nhiệm\nHướng dẫn được duyệt / policy", fillcolor="#fee2e2"];
  ticket [label="Backend tạo ticket + routing\nĐúng BQL / scope / generation", fillcolor="#dbeafe"];
  room [label="Supervisor mở session riêng\nSpecialist + tasks + context + tools", fillcolor="#ccfbf1"];
  info [label="Hỏi thêm → cư dân trả lời\nĐúng pending request / version", fillcolor="#ffedd5"];
  plan [label="Backend lưu phương án có phiên bản\nBQL duyệt", fillcolor="#dbeafe"];
  consent [label="Cư dân đồng ý nếu policy yêu cầu\nSửa → bản mới + duyệt lại", fillcolor="#ffedd5"];
  work [label="Backend cho phép và giao nhân viên\nNhận việc → ảnh trước / sau → kết quả", fillcolor="#dbeafe"];
  qc [label="Nghiệm thu / QC mọi việc bắt buộc\nChưa đạt → xử lý tiếp"];
  done [label="Backend chấp nhận hoàn tất\nSupervisor gửi completed", fillcolor="#ccfbf1"];
  confirm [label="Backend xin cư dân xác nhận\nChưa hài lòng → xử lý tiếp", fillcolor="#ffedd5"];
  close [label="Backend đóng theo đủ điều kiện\nLưu audit + nguồn học kinh nghiệm", fillcolor="#dbeafe"];
  msg -> be -> r;
  r -> qa [label="Hỏi kiến thức"];
  r -> help [label="Có quy trình phù hợp"];
  r -> emergency [label="Policy khẩn"];
  r -> ticket [label="Cần xử lý onsite"];
  help -> ticket [label="Không tự xử lý được"];
  emergency -> ticket;
  ticket -> room;
  room -> info [label="Thiếu dữ kiện"];
  info -> room [label="Backend xác minh trả lời"];
  room -> plan;
  plan -> consent;
  plan -> work [label="Được miễn cư dân duyệt"];
  consent -> work [label="Đúng bản đã duyệt"];
  consent -> plan [label="Yêu cầu sửa"];
  work -> qc -> done -> confirm -> close;
  qc -> work [label="Chưa đạt"];
  confirm -> ticket [label="Tiếp tục / reopen\ngeneration do backend cấp"];
}
