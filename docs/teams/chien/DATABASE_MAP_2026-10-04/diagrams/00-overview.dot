"legend" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="380" ALIGN="LEFT" BGCOLOR="#e5efff"><B>193 bảng PostgreSQL · 682 FK</B></TD></TR><TR><TD WIDTH="380" ALIGN="LEFT">148 baseline + 45 extension</TD></TR><TR><TD WIDTH="380" ALIGN="LEFT"><FONT POINT-SIZE="13">Sơ đồ nhóm/luồng logic; nét đứt không phải FK</FONT></TD></TR><TR><TD WIDTH="380" ALIGN="LEFT"><FONT POINT-SIZE="13">RLS/FORCE: 175; kiểm live ngày 04/10/2026</FONT></TD></TR><TR><TD WIDTH="380" ALIGN="LEFT"><FONT POINT-SIZE="13">193 PostgreSQL + 9 SQLite = 202 bảng ứng dụng/runtime</FONT></TD></TR></TABLE>>];
