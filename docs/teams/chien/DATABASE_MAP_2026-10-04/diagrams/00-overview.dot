"finance" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="231" ALIGN="LEFT" BGCOLOR="#fff0d5"><B>Chi phí / thanh toán</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT">9 bảng</TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT POINT-SIZE="13">Invoice, payment, refund, budget</FONT></TD></TR></TABLE>>];
