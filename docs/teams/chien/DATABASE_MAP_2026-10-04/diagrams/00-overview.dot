digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.5", nodesep="0.65", ranksep="0.85", splines=polyline, outputorder=edgesfirst, fontname="Segoe UI", fontsize=23,labelloc=t,label="TOÀN DỰ ÁN · CẤU TRÚC DỮ LIỆU VÀ LUỒNG LOGIC"];
node [shape=plain,fontname="Segoe UI",fontsize=16];
edge [fontname="Segoe UI",fontsize=12,color="#56667d",arrowsize=0.65];
"authority" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="223" ALIGN="LEFT" BGCOLOR="#e2f3e9"><B>Tenant / quyền / nơi ở</B></TD></TR><TR><TD WIDTH="223" ALIGN="LEFT">31 bảng</TD></TR><TR><TD WIDTH="223" ALIGN="LEFT"><FONT POINT-SIZE="13">Tài khoản, authority: 15</FONT></TD></TR><TR><TD WIDTH="223" ALIGN="LEFT"><FONT POINT-SIZE="13">Địa bàn, nhân sự, danh mục: 16</FONT></TD></TR></TABLE>>];
"agent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="172" ALIGN="LEFT" BGCOLOR="#ede5ff"><B>Agent và thực thi</B></TD></TR><TR><TD WIDTH="172" ALIGN="LEFT">16 bảng</TD></TR><TR><TD WIDTH="172" ALIGN="LEFT"><FONT POINT-SIZE="13">Factory/agent: 10</FONT></TD></TR><TR><TD WIDTH="172" ALIGN="LEFT"><FONT POINT-SIZE="13">Runtime/run/context: 6</FONT></TD></TR></TABLE>>];
"chat" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="199" ALIGN="LEFT" BGCOLOR="#ede5ff"><B>Chat và phòng agent</B></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT">18 bảng</TD></TR><TR><TD WIDTH="199" ALIGN="LEFT"><FONT POINT-SIZE="13">Channels/messages/teams</FONT></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT"><FONT POINT-SIZE="13">Reception ↔ Supervisor V2</FONT></TD></TR></TABLE>>];
"ticket" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="243" ALIGN="LEFT" BGCOLOR="#e5efff"><B>Ticket, triage và SLA</B></TD></TR><TR><TD WIDTH="243" ALIGN="LEFT">17 bảng</TD></TR><TR><TD WIDTH="243" ALIGN="LEFT"><FONT POINT-SIZE="13">Assessment → decision → dispatch</FONT></TD></TR></TABLE>>];
"work" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="225" ALIGN="LEFT" BGCOLOR="#e5efff"><B>Công việc và Operations</B></TD></TR><TR><TD WIDTH="225" ALIGN="LEFT">17 bảng</TD></TR><TR><TD WIDTH="225" ALIGN="LEFT"><FONT POINT-SIZE="13">Thực thi, approvals, evidence: 6</FONT></TD></TR><TR><TD WIDTH="225" ALIGN="LEFT"><FONT POINT-SIZE="13">Operations mở rộng: 11</FONT></TD></TR></TABLE>>];
"resident" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="262" ALIGN="LEFT" BGCOLOR="#e5efff"><B>Resident UI / intake / kết quả</B></TD></TR><TR><TD WIDTH="262" ALIGN="LEFT">11 bảng</TD></TR><TR><TD WIDTH="262" ALIGN="LEFT"><FONT POINT-SIZE="13">Backend giữ đóng/mở và xác nhận</FONT></TD></TR></TABLE>>];
"rag" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD WIDTH="291" ALIGN="LEFT" BGCOLOR="#fff0d5"><B>RAG + memory</B></TD></TR><TR><TD WIDTH="291" ALIGN="LEFT">19 bảng</TD></TR><TR><TD WIDTH="291" ALIGN="LEFT"><FONT POINT-SIZE="13">Documents → versions → chunks → vectors</FONT></TD></TR></TABLE>>];
