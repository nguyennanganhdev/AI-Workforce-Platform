# Copy to ignored deployment.env. URL-encode credentials in connection URLs.
# Use existing migrated PostgreSQL with separate restricted runtime roles.
VINHOMES_TENANT_ID=
VINHOMES_API_DATABASE_URL=
KNOWLEDGE_DATABASE_URL=
TECHNICAL_API_DATABASE_URL=
# Role riêng của dịch vụ lịch chạy agent (`routines`): chỉ các bảng lịch và hàng đợi. Tạo role trước khi chạy job `upgrade`:
#   CREATE ROLE vinhomes_routines LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS;
ROUTINES_DATABASE_URL=
# OpenBot platform shares canonical users.id and tenant scope with the business database.
OPENBOT_DATABASE_URL=
OPENBOT_WORKSPACE_ID=
OPENBOT_KEY_ENCRYPTION_KEY=
# Public Operations origin for account consent callbacks; browser uploads need a reachable S3 origin.
OPERATIONS_PUBLIC_URL=http://localhost:3020
# Only the restore verification job receives this administrator URL (it creates separate databases).
RESTORE_ADMIN_DATABASE_URL=
MONITOR_INTERVAL_SECONDS=15
MONITOR_ALERT_WEBHOOK=
# Database owner, used only by the upgrade job (migrations and grants). Leave empty otherwise.
MIGRATION_DATABASE_URL=
# Same PostgreSQL host, separately provisioned database owned by a non-superuser role.
COORDINATION_DATABASE_URL=
KNOWLEDGE_BASE_ID=
RESIDENT_SIGNING_KEY=
RECEPTION_DELEGATION_KEY=
RECEPTION_SERVICE_TOKEN=
COORDINATION_SERVICE_TOKEN=
TECHNICAL_TOOLS_SERVICE_TOKEN=
ROUTINES_SERVICE_TOKEN=
# Base64 of 32 bytes (openssl rand -base64 32). Seals the tokens of external MCP connections of
# management's agents. Keep it with the backups: a different key cannot open tokens already stored.
CONNECTIONS_KEY=
# Số ngày giữ nhật ký (audit). Để trống: giữ mãi. Job `audit-retention` xóa các dòng cũ hơn số ngày này.
AUDIT_RETENTION_DAYS=
# Nơi lưu ảnh và tệp: bucket riêng tư trên MinIO đi kèm (mặc định) hoặc một dịch vụ S3 khác (đặt S3_ENDPOINT).
# S3_ACCESS_KEY / S3_SECRET_KEY là khóa của riêng API (khóa bí mật từ 8 ký tự). Với MinIO đi kèm, đặt thêm tài khoản
# quản trị của MinIO ở S3_ADMIN_*: job `storage` dùng nó để tạo bucket và cấp cho khóa của API quyền trên đúng bucket đó.
# Với dịch vụ S3 khác: để trống S3_ADMIN_* và dùng khóa đã được cấp quyền sẵn.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=vinhomes-files
# Browser-reachable S3 origin. HTTPS when the UI uses HTTPS; no credentials or path in this URL.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# STORAGE_DOMAIN=storage.example.com
# Trang quản trị MinIO: http://localhost:9001, đăng nhập bằng S3_ADMIN_ACCESS_KEY / S3_ADMIN_SECRET_KEY.
# S3_CONSOLE_PORT=9001
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MANAGED_AGENT_TOKEN=
FACTORY_SERVICE_TOKEN=
FACTORY_MODEL=gpt-5.5
OPENAI_API_KEY=
RECEPTION_AGENT=loop
SUPERVISOR_APPROVES_PLANS=1
RECEPTION_MODEL=gpt-6-luna
COORDINATION_MODEL=gpt-5.4-mini
SPECIALIST_MODEL=gpt-5.5
# Model của agent chuyên môn có đọc được ảnh không. Đặt 0 khi dùng model chỉ đọc chữ: ảnh trong câu hỏi khi đó chỉ
# được báo tên cho agent, thay vì làm cả lượt trả lời lỗi ở model.
SPECIALIST_SEES_IMAGES=1
# Mỗi vai trò có thể dùng nhà cung cấp khác OpenAI (xem README, mục "Model theo vai trò"). Để trống: dùng OpenAI
# với OPENAI_API_KEY. PROVIDER: openai, google, deepseek, groq, anthropic, custom (custom cần BASE_URL).
RECEPTION_MODEL_PROVIDER=
RECEPTION_MODEL_API_KEY=
RECEPTION_MODEL_BASE_URL=
COORDINATION_MODEL_PROVIDER=
COORDINATION_MODEL_API_KEY=
COORDINATION_MODEL_BASE_URL=
# Tên model mà nhà cung cấp ghi trong câu trả lời, khi khác tên đã cấu hình (Supervisor từ chối model bị thay).
COORDINATION_MODEL_ANSWERS_AS=
# Agent chuyên môn: đặt cả khóa và địa chỉ API của nhà cung cấp, hoặc để trống cả hai.
SPECIALIST_MODEL_API_KEY=
SPECIALIST_MODEL_BASE_URL=
# Embedding của tri thức: khóa và địa chỉ riêng. Để trống: dùng OPENAI_API_KEY. Đổi model embedding phải nhập lại tri thức.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Mã các nhóm dịch vụ có hóa đơn tính là sửa chữa (agent báo cáo), cách nhau bằng dấu phẩy. Để trống: không báo tổng.
REPAIR_CATEGORY_CODES=
VINHOMES_BIND_ADDRESS=127.0.0.1
# HTTPS cho cổng BQL/nhân viên và cổng cư dân (chạy thêm `--profile tls`): tên miền của từng giao diện. Khi đó đặt SECURE_COOKIES=1 và ghi
# hai địa chỉ https vào VINHOMES_ALLOWED_ORIGINS. PROXY_TLS để trống: Caddy tự xin chứng chỉ cho tên miền công khai.
# OPERATIONS_DOMAIN=vanhanh.example.com
# RESIDENT_DOMAIN=cudan.example.com
# PROXY_TLS=
SECURE_COOKIES=0
VINHOMES_API_PORT=8000
# Hai cổng: BQL/nhân viên dùng chung OPERATIONS_PORT (3020); cư dân dùng RESIDENT_PORT (3011).
VINHOMES_ALLOWED_ORIGINS=http://localhost:3020,http://localhost:3011
