FROM oven/bun:1.3.14
WORKDIR /opt/workforce
COPY package.json bun.lock ./
COPY app/package.json ./app/package.json
COPY server/package.json ./server/package.json
COPY worker/package.json ./worker/package.json
COPY resident-app/package.json ./resident-app/package.json
RUN bun install --frozen-lockfile
COPY agent-factory ./agent-factory
RUN cd agent-factory && bun install --frozen-lockfile --ignore-scripts
COPY app ./app
COPY server ./server
COPY worker ./worker
COPY resident-app ./resident-app
COPY shared ./shared
COPY scripts ./scripts
COPY examples ./examples
COPY bunfig.toml ./
COPY tsconfig.base.json ./
COPY .env.example ./
CMD ["bun", "test", "server/tests/business-auth.test.ts", "server/tests/config.test.ts", "server/tests/guards.test.ts", "app/tests/serve.test.ts"]
