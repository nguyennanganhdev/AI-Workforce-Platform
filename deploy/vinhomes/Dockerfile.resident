# The resident app as static files behind nginx, which forwards /api/business to the business API.
FROM oven/bun:1.3.14 AS build
WORKDIR /opt/workforce
COPY package.json bun.lock tsconfig.base.json ./
COPY app/package.json ./app/package.json
COPY server/package.json ./server/package.json
COPY worker/package.json ./worker/package.json
COPY resident-app/package.json ./resident-app/package.json
RUN bun install --frozen-lockfile
COPY resident-app ./resident-app
ENV VITE_ALLOW_DEMO_BACKEND=false VITE_ENABLE_UI_PREVIEW=false
RUN cd resident-app && bun run build

FROM nginx:1.27-alpine
COPY deploy/vinhomes/resident.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /opt/workforce/resident-app/dist /usr/share/nginx/html
EXPOSE 3011
