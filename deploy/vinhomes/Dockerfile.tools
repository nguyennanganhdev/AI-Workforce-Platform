FROM oven/bun:1.3.14
WORKDIR /opt/workforce
COPY package.json bun.lock ./
COPY app/package.json ./app/package.json
COPY server/package.json ./server/package.json
COPY worker/package.json ./worker/package.json
COPY resident-app/package.json ./resident-app/package.json
RUN bun install --frozen-lockfile --production
COPY server/src ./server/src
COPY shared ./shared
# What the upgrade job needs: the migrations, the migrator and the grants of the two runtime roles.
COPY server/drizzle ./server/drizzle
COPY server/scripts/migrate.ts server/scripts/grant_technical_api_role.sql ./server/scripts/
COPY services/vinhomes-api/scripts/grant_v3_api_role.sql ./services/vinhomes-api/scripts/
# Beside the server's scripts, so it resolves the server's packages as they do.
COPY deploy/vinhomes/upgrade.ts ./server/scripts/vinhomes-upgrade.ts
USER bun
CMD ["bun", "server/src/knowledge/serve.ts"]
