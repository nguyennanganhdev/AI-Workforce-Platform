FROM postgres:17
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/backup-env \
    && /opt/backup-env/bin/pip install --no-cache-dir 'minio>=7.2,<8'
COPY deploy/vinhomes/backup.py /opt/backup.py
ENV PATH=/opt/backup-env/bin:$PATH
ENTRYPOINT ["python", "/opt/backup.py"]
CMD ["backup"]
