{
  "name": "vagents-landing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .artifacts/prerender && node scripts/prerender.mjs",
