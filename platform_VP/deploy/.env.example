# Generate real local values with init-local.ps1. Never commit deploy/.env.
VP_DB_PASSWORD=
VP_ENCRYPTION_KEY=
VP_BOOTSTRAP_EMAIL=admin@platform.local
VP_BOOTSTRAP_PASSWORD=
# Only localhost HTTP development; set true with HTTPS in deployment.
VP_COOKIE_SECURE=false
VP_TRUSTED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
VP_WORKERS=8
VP_MAX_SESSIONS=20
VP_MONTHLY_BUDGET_MICROS=100000000
VP_SESSION_BUDGET_MICROS=500000
VP_JEV_ENABLED=false
VP_ALLOW_PRIVATE_ENDPOINTS=false
