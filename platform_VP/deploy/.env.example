# Environment of deploy/compose.yml. Do not edit this file for a deployment: run
#     python init_env.py            (production-like: real models, you add the model keys)
#     python init_env.py --demo     (the scripted model and the sample MCP server, for smoke.py)
# It copies this file to deploy/.env (git-ignored) and replaces every __...__ value with a fresh random one.
# deploy/.env holds secrets: keep it out of git, out of images and out of backups of the database.
# Format: KEY=value, one per line, no quotes, no comment after a value.

# ---------------------------------------------------------------------------------------------------------------------
# 1. Secrets (generated)
# ---------------------------------------------------------------------------------------------------------------------
# Admin keys of /platform/v1 and of the console: "key:tenant", several separated by ";". The tenant is the name the
# admin's data lives under. Rotate: add the new pair, restart the api, move the callers, remove the old pair, restart.
AWP_ADMIN_KEYS=__GENERATED_ADMIN_KEY__:__TENANT__

# Fernet key that seals the provider signing secrets and the MCP headers stored in the database, and keys the labels
# of admin actions in the history. LOSING IT LOSES EVERY SEALED SECRET (signing keys and MCP headers must then be
# made again); changing it does not re-seal old rows. Back it up apart from the database.
AWP_SECRET_KEY=__GENERATED_FERNET_KEY__

# Password of the PostgreSQL role "awp" (the image applies it only when the data volume is first created).
POSTGRES_PASSWORD=__GENERATED_PG_PASSWORD__

# ---------------------------------------------------------------------------------------------------------------------
# 2. Databases
# ---------------------------------------------------------------------------------------------------------------------
# The tables of awp (awp_*, wf_*), and the storage of AgentScope (sessions, messages). Two databases of the compose
# PostgreSQL; the migrate job brings both to the latest revision before the api starts. The password inside both URLs
# is POSTGRES_PASSWORD above (keep the three in step). To use a PostgreSQL elsewhere, point both URLs at it.
AWP_DB_URL=postgresql+asyncpg://awp:__GENERATED_PG_PASSWORD__@postgres:5432/awp
AWP_AGENTSCOPE_DB_URL=postgresql+asyncpg://awp:__GENERATED_PG_PASSWORD__@postgres:5432/awp_storage
# Pool of each of the two engines. processes x 2 x (size + overflow) must stay under max_connections (100): with two
# replicas (profile `two`) 10 + 10 keeps that at 80.
AWP_DB_POOL_SIZE=10
AWP_DB_MAX_OVERFLOW=10

# The message bus the API processes share (the compose Redis). With it several replicas may run on one database;
# without it (empty) there may be one process only, and a second one refuses to start. The password inside the URL is
# REDIS_PASSWORD below (keep the two in step).
REDIS_PASSWORD=__GENERATED_REDIS_PASSWORD__
AWP_REDIS_URL=redis://:__GENERATED_REDIS_PASSWORD__@redis:6379/0
# AWP_DB_POOL_TIMEOUT=30
# AWP_DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------------------------------------------------
# 3. What the host sees
# ---------------------------------------------------------------------------------------------------------------------
# Host ports, all bound to 127.0.0.1 by compose.yml. Change one when it is taken on this machine.
AWP_HOST_PORT=8800
# The second API replica (docker compose --profile two).
AWP_HOST_PORT2=8801
AWP_PG_HOST_PORT=5590
# Tag of the image compose builds and runs (awp-platform:<tag>). Upgrade = new tag; rollback = the previous tag.
AWP_IMAGE_TAG=0.3.0

# ---------------------------------------------------------------------------------------------------------------------
# 4. Models
# ---------------------------------------------------------------------------------------------------------------------
# The model catalog file ON THE HOST (relative to deploy/), mounted read-only at /etc/awp/models.yaml.
#   ./models.yaml       your catalog (start from ../core/models.example.yaml; init_env.py makes the copy)
#   ./models.demo.yaml  the scripted demo model (profile demo)
AWP_MODELS_HOST_FILE=__MODELS_FILE__
# Provider keys named by the catalog. A model whose key is missing is simply not offered (GET /platform/v1/models).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# Demo only: switches the scripted model on. Any value; it is not a secret. Leave empty outside the demo.
DEMO_MODEL_KEY=__DEMO_MODEL_KEY__
# Demo only: the token the sample MCP server expects (smoke.py sends it as the Authorization header of that server).
DEMO_MCP_TOKEN=demo-mcp-token

# ---------------------------------------------------------------------------------------------------------------------
# 5. Behaviour (defaults shown; uncomment to change). Full list with meanings: docs/WORKFORCE_V1_VAN_HANH.md section 2
# ---------------------------------------------------------------------------------------------------------------------
# Partner MCP servers at private addresses are refused (SSRF guard). 1 only in a closed network or for the demo, whose
# sample MCP server lives on the compose network.
AWP_MCP_ALLOW_PRIVATE=__MCP_ALLOW_PRIVATE__
# The release gate: a profile version is published only after its evaluation passed, or with a recorded override.
AWP_EVAL_GATE=1
# Cost ceiling of one workflow (0 = none), in USD and, for unpriced models, in tokens.
AWP_CASE_BUDGET_USD=0
AWP_CASE_BUDGET_TOKENS=0
# Seconds a partner POST waits for the turn of the agent before answering 202.
# AWP_WF_WAIT_SECONDS=25
# A workflow that should be moving but ran nothing this long needs attention; one waiting for an outside event with
# no news for this many hours needs attention too.
# AWP_CASE_STALL_SECONDS=900
# AWP_REQUEST_TIMEOUT_HOURS=72
# How long an approval asked of a resident stays open.
# AWP_APPROVAL_TTL_SECONDS=86400
# Retention (contract section 12: at least 90 days of events after close, 180 days of provider dedupe rows).
# AWP_EVENT_RETENTION_DAYS=90
# AWP_INBOX_RETENTION_DAYS=180
# AWP_CLOSED_RETENTION_DAYS=90
# AWP_RETENTION_EVERY_SECONDS=3600
# On SIGTERM: seconds the open requests get to finish before they are cancelled (an event stream never ends by
# itself). Keep it under stop_grace_period of compose.yml (45s).
# AWP_SHUTDOWN_SECONDS=20
# Per API key: requests per minute (counted in each process: N replicas allow N times this), and open event streams
# (counted over all replicas through Redis).
# AWP_WF_RATE_PER_MINUTE=600
# AWP_WF_MAX_STREAMS=20
# A replica says it lives every quarter of this. The jobs, the session locks and the half-sent requests of one that was
# silent this long are taken over by the others: lower = faster recovery after a crash, and a process that merely
# stalls for longer than this is taken for dead while it still works.
# AWP_WF_LEASE_SECONDS=60
# Never in a deployment: lets requests without a key act as tenant "dev".
# AWP_DEV_OPEN=0

# ---------------------------------------------------------------------------------------------------------------------
# 6. Private image assets (MinIO)
# ---------------------------------------------------------------------------------------------------------------------
# The API reaches MinIO on the compose network. Signed links must use an address that the consuming MCP/model can
# reach: the default works for the demo MCP in this stack; external consumers need a reachable HTTPS endpoint.
MINIO_ROOT_USER=awp
MINIO_ROOT_PASSWORD=__GENERATED_MINIO_PASSWORD__
AWP_MINIO_HOST_PORT=9190
AWP_MINIO_CONSOLE_HOST_PORT=9191
AWP_ASSET_BACKEND=s3
AWP_S3_ENDPOINT=http://minio:9000
AWP_S3_PUBLIC_ENDPOINT=http://minio:9000
AWP_S3_BUCKET=awp-assets
AWP_S3_ACCESS_KEY=awp
AWP_S3_SECRET_KEY=__GENERATED_MINIO_PASSWORD__
AWP_S3_REGION=us-east-1
AWP_S3_PATH_STYLE=1
AWP_ASSET_MAX_BYTES=5242880
AWP_ASSET_URL_TTL=900
