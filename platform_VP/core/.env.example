# Who may call /platform/v1 and the AgentScope API: admins, one key per tenant. Keys are secrets; use long random values.
# Partners do not use these: each partner client gets its own keys from the admin API (docs/WORKFORCE_V1_HUONG_DAN_KET_NOI.md).
AWP_ADMIN_KEYS=change-me-admin:tenant-a               # key:tenant ; separate with ;

# Databases. SQLite is for development only; use PostgreSQL 16 in production (pip install "awp[postgres]"):
#   AWP_DB_URL=postgresql+asyncpg://awp:***@db:5432/awp
#   AWP_AGENTSCOPE_DB_URL=postgresql+asyncpg://awp:***@db:5432/awp_storage     (may be the same database)
AWP_DB_URL=sqlite+aiosqlite:///./awp.db
AWP_AGENTSCOPE_DB_URL=sqlite+aiosqlite:///./agentscope.db
# 1 (default, development): create missing tables at start-up. PRODUCTION: 0 -- the tables come from
# `python -m awp migrate --storage` (a deploy step) and the start is refused on a database not at the latest revision.
# AWP_AUTO_CREATE=1
# PostgreSQL pool of each engine: connections kept, extra allowed under load, seconds to wait for one, seconds before one is replaced.
# Processes x 2 x (size + overflow) must stay under the server's max_connections.
# AWP_DB_POOL_SIZE=10
# AWP_DB_MAX_OVERFLOW=20
# AWP_DB_POOL_TIMEOUT=30
# AWP_DB_POOL_RECYCLE=1800
AWP_WORKSPACE_DIR=./awp_workspaces

# Models (see models.example.yaml)
AWP_MODELS_FILE=./models.yaml
# OPENAI_API_KEY= / ANTHROPIC_API_KEY= / DASHSCOPE_API_KEY= ... as needed

# Cost ceiling per workflow (its case). 0 = no ceiling.
AWP_CASE_BUDGET_USD=0
AWP_CASE_BUDGET_TOKENS=0

# A workflow that should be moving (accepted/active) but has run nothing for this long needs attention; one that waits
# for an outside event with no news for this many hours needs attention too (it is never closed by either).
# AWP_CASE_STALL_SECONDS=900
# AWP_REQUEST_TIMEOUT_HOURS=72

# Optional second opinion on final answers (Jev by TypeSafe AI). Off by default.
AWP_JEV_ENABLED=0
AWP_JEV_MODEL=jev-latest
AWP_JEV_MIN_SUPPORT=0.6
# TYPESAFE_API_KEY=

# Local development only: lets requests without a key act as tenant "dev".
# AWP_DEV_OPEN=1

# Workforce v1 partner API
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Required unless AWP_DEV_OPEN is set. Seals provider signing secrets and MCP headers.
# AWP_SECRET_KEY=
# AWP_WF_WAIT_SECONDS=25
# AWP_WF_BODY_LIMIT=262144
# AWP_WF_TEXT_LIMIT=20000
# AWP_WF_RATE_PER_MINUTE=600
# AWP_WF_HEARTBEAT_SECONDS=15
# AWP_WF_REVALIDATE_SECONDS=30
# AWP_WF_SSE_POLL_SECONDS=1
# AWP_WF_MAX_STREAMS=20
# AWP_APPROVAL_TTL_SECONDS=86400
# AWP_EVENT_RETENTION_DAYS=90
# AWP_INBOX_RETENTION_DAYS=180
# Retention runs in ONE process of the fleet every AWP_RETENTION_EVERY_SECONDS (0 = never). A period of 0 days keeps that kind for ever.
# Contract 12 asks for at least 90 days of events after close and 180 days of provider dedupe rows, unless agreed otherwise.
# AWP_CLOSED_RETENTION_DAYS=90          # finished jobs and turns of closed workflows
# AWP_RETENTION_EVERY_SECONDS=3600
# AWP_WF_ACK_SECONDS=10
# AWP_WF_JOB_ATTEMPTS=3
# AWP_WF_TURN_TIMEOUT_SECONDS=900
# Partner tools over MCP: allow routes that point at private addresses (tests, closed networks only)
# AWP_MCP_ALLOW_PRIVATE=0
# AWP_MCP_LIST_TTL_SECONDS=300
# AWP_MCP_MAX_RESPONSE_BYTES=262144
# AWP_WF_OP_GRACE_SECONDS=30
# AWP_WF_STATUS_POLL_SECONDS=30
# Provider events: clock window of the signature, how long an event that matches no operation waits, how long a delta event waits for its predecessor
# AWP_WF_PROVIDER_SKEW_SECONDS=300
# AWP_WF_QUARANTINE_SECONDS=3600
# AWP_WF_DELTA_HOLD_SECONDS=3600
# AWP_WF_DELTA_FIRST_SECONDS=5
# AWP_WF_QUARANTINE_MAX=200
# Building and releasing agents. The gate: a profile version is published only after the latest evaluation of that exact
# version passed, or with a recorded override. Leave it on; 0 is for a development machine without a model.
# AWP_EVAL_GATE=1
# AWP_EVAL_CASE_TIMEOUT_SECONDS=180     # the longest one evaluation case may take
# AWP_EVAL_CASE_BUDGET_USD=0.5          # budget of one case (0 = no ceiling), and the token ceiling for unpriced models
# AWP_EVAL_CASE_BUDGET_TOKENS=400000
# AWP_EVAL_PARALLEL=2                   # evaluation runs of ONE tenant at once in one process (tenants do not share slots)
# AWP_BUILDER_OVERLAP_THRESHOLD=0.5     # 0..1: a proposed agent that overlaps an existing one this much becomes "reuse"
# AWP_BUILDER_TIMEOUT_SECONDS=90
