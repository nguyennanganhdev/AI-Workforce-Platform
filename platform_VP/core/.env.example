# Workforce v1: use scripts/init_local.py to generate local secrets.
# Partner customer/provider credentials are provisioned through /workforce/v1/admin/clients.
AWP_ADMIN_KEYS=replace-with-long-random-key:local
AWP_SECRET_KEY=replace-with-fernet-key
AWP_POSTGRES_PASSWORD=replace-with-isolated-database-password
AWP_MINIO_ACCESS_KEY=awp-local
AWP_MINIO_SECRET_KEY=replace-with-long-random-secret
AWP_MINIO_ENDPOINT=127.0.0.1:9090
AWP_MINIO_SECURE=0
AWP_MINIO_UPLOAD_ORIGIN=http://127.0.0.1:9090
AWP_REDIS_URL=redis://127.0.0.1:6389/0
AWP_WORKFORCE_WORKERS=20
AWP_WORKFORCE_WAIT_SECONDS=25
AWP_WORKFORCE_LEASE_SECONDS=60
# USD per tenant per UTC calendar month; route budgets also apply.
AWP_WORKFORCE_MONTHLY_BUDGET_USD=100
# Generate PBKDF2 hashes with scripts/init_local.py; never put plaintext passwords here.
AWP_CONSOLE_USERS={}
AWP_CONSOLE_SECURE_COOKIE=1
# Legacy pack integration is optional and separate from Workforce v1.
# AWP_SERVICE_KEYS=legacy-key:tenant:domain
# AWP_PACKS=awp_vinhomes.pack:VinhomesPack

# Databases. SQLite is for development only; use PostgreSQL in production.
AWP_DB_URL=sqlite+aiosqlite:///./awp.db
AWP_AGENTSCOPE_DB_URL=sqlite+aiosqlite:///./agentscope.db
AWP_WORKSPACE_DIR=./awp_workspaces

# Models (see models.example.yaml)
AWP_MODELS_FILE=./models.yaml
# OPENAI_API_KEY= / ANTHROPIC_API_KEY= / DASHSCOPE_API_KEY= ... as needed

# Cost ceiling per case. 0 = no ceiling.
AWP_CASE_BUDGET_USD=0
AWP_CASE_BUDGET_TOKENS=0

# Optional second opinion on final answers (Jev by TypeSafe AI). Off by default.
AWP_JEV_ENABLED=0
AWP_JEV_MODEL=jev-latest
AWP_JEV_MIN_SUPPORT=0.6
# TYPESAFE_API_KEY=

# Local development only: lets requests without a key act as tenant "dev".
# AWP_DEV_OPEN=1
