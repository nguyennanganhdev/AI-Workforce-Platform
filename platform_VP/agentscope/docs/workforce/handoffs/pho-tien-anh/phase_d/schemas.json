{
  "schema_version": "pta-release-1",
  "schemas": {
    "PublishedVersion": {
      "$defs": {
        "FrozenEvaluation": {
          "additionalProperties": false,
          "description": "JSON string sealing prevents nested DTO mappings from mutating evidence.",
          "properties": {
            "payload_json": {
              "title": "Payload Json",
              "type": "string"
            },
            "content_hash": {
              "title": "Content Hash",
              "type": "string"
            }
          },
          "required": [
            "payload_json",
            "content_hash"
          ],
          "title": "FrozenEvaluation",
          "type": "object"
        },
        "Scope": {
          "additionalProperties": false,
          "description": "Immutable owner boundary for every Workforce resource.",
          "properties": {
            "tenant_id": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Tenant Id",
              "type": "string"
            },
            "domain_id": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Domain Id",
              "type": "string"
            },
            "area_id": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Area Id",
              "type": "string"
            },
            "manager_account_id": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Manager Account Id",
              "type": "string"
            }
          },
          "required": [
            "tenant_id",
            "domain_id",
            "area_id",
            "manager_account_id"
          ],
          "title": "Scope",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "agent_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "version_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Version Id",
          "type": "string"
        },
        "evaluation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "frozen": {
          "$ref": "#/$defs/FrozenEvaluation"
        },
        "published_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Published By",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "agent_id",
        "version_id",
        "evaluation_id",
        "frozen",
        "published_by",
        "published_at"
      ],
      "title": "PublishedVersion",
      "type": "object"
    },
    "ReleaseSelection": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "draft_revision": {
          "minimum": 1,
          "title": "Draft Revision",
          "type": "integer"
        },
        "evaluation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "deployment_revision": {
          "minimum": 0,
          "title": "Deployment Revision",
          "type": "integer"
        }
      },
      "required": [
        "draft_id",
        "draft_revision",
        "evaluation_id",
        "deployment_revision"
      ],
      "title": "ReleaseSelection",
      "type": "object"
    },
    "ReleaseContext": {
      "$defs": {
        "ExpectedTurn": {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "title": "Cause",
              "type": "string"
            },
            "workflow_state": {
              "$ref": "#/$defs/WorkflowState"
            },
            "next_action": {
              "$ref": "#/$defs/NextAction"
            },
            "llm_calls": {
              "minimum": 0,
              "title": "Llm Calls",
              "type": "integer"
            },
            "side_effect_calls": {
              "minimum": 0,
              "title": "Side Effect Calls",
              "type": "integer"
            },
            "tracking_records": {
              "minimum": 0,
              "title": "Tracking Records",
              "type": "integer"
            },
            "approval_granted": {
              "default": false,
              "title": "Approval Granted",
              "type": "boolean"
            },
            "provider_confirmed": {
              "default": false,
              "title": "Provider Confirmed",
              "type": "boolean"
            }
          },
          "required": [
            "cause",
            "workflow_state",
            "next_action",
            "llm_calls",
            "side_effect_calls",
            "tracking_records"
          ],
          "title": "ExpectedTurn",
          "type": "object"
        },
        "LifecycleCase": {
          "additionalProperties": false,
          "properties": {
            "case_id": {
              "title": "Case Id",
              "type": "string"
            },
            "pattern": {
              "enum": [
                "response_only",
                "interactive",
                "external_tracking"
              ],
              "title": "Pattern",
              "type": "string"
            },
            "turns": {
              "items": {
                "$ref": "#/$defs/ExpectedTurn"
              },
              "minItems": 1,
              "title": "Turns",
              "type": "array"
            }
          },
          "required": [
            "case_id",
            "pattern",
            "turns"
          ],
          "title": "LifecycleCase",
          "type": "object"
        },
        "LifecycleSuite": {
          "additionalProperties": false,
          "properties": {
            "suite_version": {
              "title": "Suite Version",
              "type": "string"
            },
            "cases": {
              "items": {
                "$ref": "#/$defs/LifecycleCase"
              },
              "minItems": 1,
              "title": "Cases",
              "type": "array"
            }
          },
          "required": [
            "suite_version",
            "cases"
          ],
          "title": "LifecycleSuite",
          "type": "object"
        },
        "NextAction": {
          "enum": [
            "none",
            "submit_reply",
            "submit_approval",
            "watch_request",
            "watch_events",
            "confirm_close",
            "resolve_attention"
          ],
          "title": "NextAction",
          "type": "string"
        },
        "WorkflowState": {
          "enum": [
            "accepted",
            "active",
            "waiting_external_event",
            "awaiting_user",
            "awaiting_approval",
            "awaiting_confirmation",
            "needs_attention",
            "blocked_authorization",
            "blocked_route_changed",
            "closed"
          ],
          "title": "WorkflowState",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Current server configuration, never configuration supplied by a client.",
      "properties": {
        "runtime_profile": {
          "additionalProperties": true,
          "title": "Runtime Profile",
          "type": "object"
        },
        "test_context": {
          "additionalProperties": true,
          "title": "Test Context",
          "type": "object"
        },
        "suite": {
          "$ref": "#/$defs/LifecycleSuite"
        }
      },
      "required": [
        "runtime_profile",
        "test_context",
        "suite"
      ],
      "title": "ReleaseContext",
      "type": "object"
    }
  }
}
