[Unit]
Description=Encrypted Platform offsite backup with read-back verification
After=awp-platform-backup.service network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/awp-platform/app/deploy/vps/offsite.py upload-latest /var/backups/awp-platform --config /etc/awp-platform/offsite.json --evidence /var/lib/awp-platform/offsite-receipt.json
TimeoutStartSec=900
