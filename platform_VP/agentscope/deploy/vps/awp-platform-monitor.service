[Unit]
Description=Platform backup, offsite, restore, health and disk checks
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/awp-platform/app/deploy/vps/monitor.py --config /etc/awp-platform/monitor.json --evidence /var/lib/awp-platform/monitor.json
