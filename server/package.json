{
  "name": "server",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "bun --env-file=../.env scripts/generate-migration.ts",
    "db:migrate": "bun --env-file=../.env scripts/migrate.ts",
    "db:check": "bun scripts/check-schema-generation.ts",
    "db:verify": "bun scripts/check-schema-generation.ts && node scripts/verify-baseline.mjs",
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/mastra": "1.1.2",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/electron": "1.7.1",
    "@better-auth/sso": "^1.7.1",
    "@composio/core": "^0.18.1",
    "@copilotkit/runtime": "1.70.1",
    "@mastra/client-js": "^1.43.0",
    "@mastra/core": "^1.64.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.7.1",
    "cel-js": "^0.8.2",
    "cron-parser": "^5",
    "drizzle-orm": "^0.45.2",
    "eventsource": "3.0.7",
    "hono": "^4.10.0",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.39.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "drizzle-kit": "^0.31.10"
  }
}
