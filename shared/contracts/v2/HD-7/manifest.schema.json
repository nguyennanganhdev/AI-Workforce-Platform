{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^D-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner_team": {
      "type": "string",
      "minLength": 1
    },
    "world_version": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "real",
        "public",
        "team_written",
        "synthetic",
        "test_run"
      ]
    },
    "origin_detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_by_operator": {
          "type": "boolean"
        },
        "generator_model": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_model": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "written_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "jsonl",
              "json",
              "csv",
              "md",
              "yaml",
              "image"
            ]
          },
          "records": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "format",
          "records"
        ]
      }
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "load_command": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "sample_checked": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "dataset_id",
    "title",
    "owner_team",
    "world_version",
    "origin",
    "origin_detail",
    "files",
    "load_command"
  ],
  "title": "HD-7 tệp kê của một bộ dữ liệu"
}
