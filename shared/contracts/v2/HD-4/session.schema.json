{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "event_id": {
        "type": "string",
        "minLength": 1
      },
      "case_id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "session.started",
          "phase.changed",
          "agent.started",
          "agent.tool_call",
          "agent.finished",
          "agent.failed",
          "entry.added",
          "entry.blocked",
          "metrics.updated",
          "human.action",
          "session.waiting",
          "session.closed"
        ]
      },
      "at": {
        "type": "string",
        "format": "date-time"
      },
      "actor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "agent",
              "human",
              "system"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id",
          "name"
        ]
      },
      "payload": {
        "type": "object"
      },
      "seq": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "event_id",
      "case_id",
      "type",
      "at",
      "actor",
      "payload"
    ],
    "title": "HD-4 một sự kiện"
  },
  "title": "HD-4 một phiên đã ghi"
}
