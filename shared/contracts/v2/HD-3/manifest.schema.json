{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "side_effect": {
      "enum": [
        "read",
        "write",
        "request"
      ]
    },
    "required_capability": {
      "type": "string",
      "minLength": 1
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "idempotent": {
      "type": "boolean"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "data_origin": {
      "enum": [
        "real",
        "public",
        "team_written",
        "synthetic",
        "test_run"
      ]
    },
    "owner_team": {
      "type": "string",
      "minLength": 1
    },
    "pack": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "side_effect",
    "required_capability",
    "timeout_ms",
    "idempotent",
    "input_schema",
    "output_schema",
    "data_origin",
    "owner_team",
    "pack"
  ],
  "title": "HD-3 bản khai một tool"
}
