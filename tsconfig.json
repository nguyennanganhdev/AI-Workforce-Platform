{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["server/src/platform/**/*.ts", "server/src/domains/**/*.ts", "shared/platform/**/*.ts", "shared/domains/**/*.ts", "domain-tools/**/*.ts"]
}
